# pixi environments
.pixi/*
!.pixi/config.toml

# The slide projection and the pages beside it, written by `pixi run
# md-to-slide` from data/ and rebuilt in CI. data/ is the source; these are
# not, so they are not carried in the history.
site/slide/
site/index.md
site/chorus.md

# Quarto render output. Its cache is ignored by site/.gitignore, which Quarto
# writes and maintains itself. A render builds each page beside its source and
# moves the lot into _site at the end, so the rest is what a render that stops
# early leaves behind.
site/_site/
site/site_libs/
site/*.html
!site/fit.html
!site/goto.html
!site/title-slide.html
